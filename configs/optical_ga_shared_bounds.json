  },
  "shared_bounds": {
    "melanin":          [0.0, 0.5],
    "blood_layer1":     [0.0, 0.1],
    "blood_layer2":     [0.0, 0.1],
    "spo2":             [0.5, 1.0],
    "g_layer0":         [0.85, 0.95],
    "g_layer1":         [0.85, 0.95],
    "g_layer2":         [0.85, 0.95],
    "d_layer0":         [3e-5, 1.5e-4],
    "d_layer1":         [0.1e-3, 0.5e-3],
    "amp_layer0":       [0.5, 1.5],
    "amp_layer1":       [0.5, 1.5],
    "amp_layer2":       [0.5, 1.5],
    "water_layer0":     [0.01, 0.8],
    "water_layer1":     [0.01, 0.8],
    "water_layer2":     [0.01, 0.8],
    "fat_layer2":       [0.05, 0.8],
    "n_mult_layer0":    [0.8, 1.2],
    "n_mult_layer1":    [0.8, 1.2],
